# ============================================================================
# WriteTool — .gitignore
#
# 这个仓库会公开（简历上的链接），所以下面每一项都是"传上去会出问题"的东西。
# 分三类：体积、构建产物、**私人数据**。
# ============================================================================

# ---------- 依赖 ----------
node_modules/
app/node_modules/
editor/node_modules/
*/node_modules/

# ---------- 构建产物 ----------
# electron 的输出，每个 100+ MB，而且每次打包都会重新生成
app/release/
app/release-*/
app/dist/
app/shots-verify/
*.blockmap

# ---------- 开发过程的截图与一次性脚本（2026-11-06 补回） ----------
# ⚠ 远端那份 .gitignore 把这一组弄丢了，结果 179 张开发截图全变成未跟踪、
#   一提交就是几十 MB。README 只用一张，其余都是逐张比对时的产物。
# ⚠ 只放行 README 用的那张 —— 用 ! 反向例外，顺序不能颠倒。
app/shots/*.png
!app/shots/main-ui.png
app/shots/*.jpg
app/shots/*.gif

# 31 个 diag-*.js / shoot-*.js 是排查问题时写的，不是产品代码
app/diag-*.js
app/shoot-*.js

# ---------- 备份 ----------
# 改技能时留的历史快照
app/builtin-skills.bak-*/
*.bak
*.bak2
*.bak-*

# ---------- ⚠⚠⚠ 私人数据：绝对不能进仓库 ----------
# 《墨染仙途》的设定库和世界设定 —— 这是作品本体，不是代码
墨染仙途-设定库.json
world-bible.json
第6章底稿-*.md
*.bak

# 跑评测留下的输出目录
结果/
结果-*/
data/

# 本地数据库（含对话记录、项目路径、用户填过的配置）
*.db
*.db-wal
*.db-shm

# ---------- 临时 ----------
app/wt_109/
*.log
.tmp/
tmp/
.tmp-shot/
*.tmp-shot/

# 2026-11-06 补：改界面时留的整目录备份，以及逐张比对用的截图目录。
# 它们不是产品代码，进仓库只会让 clone 变大。
app/_bak-*/
app/apple-shots/
app/theme-shots/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# 环境变量（万一以后有）
.env
.env.*
