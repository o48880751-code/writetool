# ============================================================================
# WriteTool — .gitignore
#
# 这个仓库会公开（简历上的链接），所以下面每一项都是"传上去会出问题"的东西。
# 分三类：体积、构建产物、**私人数据**。
# ============================================================================

# ---------- 依赖 ----------
node_modules/
app/node_modules/
editor/node_modules/
*/node_modules/

# ---------- 构建产物 ----------
# electron 的输出，每个 100+ MB，而且每次打包都会重新生成
app/release/
app/release-*/
app/dist/
app/shots-verify/
*.blockmap

# ---------- 备份 ----------
# 改技能时留的历史快照
app/builtin-skills.bak-*/
*.bak
*.bak2
*.bak-*

# ---------- ⚠⚠⚠ 私人数据：绝对不能进仓库 ----------
# 《墨染仙途》的设定库和世界设定 —— 这是作品本体，不是代码
墨染仙途-设定库.json
world-bible.json
第6章底稿-*.md
*.bak

# 跑评测留下的输出目录
结果/
结果-*/
data/

# 本地数据库（含对话记录、项目路径、用户填过的配置）
*.db
*.db-wal
*.db-shm

# ---------- 临时 ----------
app/wt_109/
*.log
.tmp/
tmp/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db

# 环境变量（万一以后有）
.env
.env.*
